---
import type { Faq } from '../copy/types';

interface Props {
  heading: string;
  faqs: Faq[];
}

const { heading, faqs } = Astro.props;
---

<section class="copy mt-16">
  <h2>{heading}</h2>
  <dl class="mt-2 divide-y divide-line border-y border-line">
    {faqs.map((faq) => (
      <div class="py-5">
        <dt class="text-copy font-semibold">{faq.q}</dt>
        <dd class="mt-2 leading-relaxed text-muted" set:html={faq.a} />
      </div>
    ))}
  </dl>
</section>
