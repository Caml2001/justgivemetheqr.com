---
import Mark from './Mark.astro';
import { getCopy } from '../copy';
import { localizePath, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  /** English path of the current page, so the language link lands on its twin. */
  pageKey?: string;
}

const { lang = 'en', pageKey = '/' } = Astro.props;
const other: Lang = lang === 'en' ? 'es' : 'en';
const copy = getCopy(lang);
const link = (path: string) => localizePath(path, lang);
---

<a
  href="#generator"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
>
  {copy.chrome.skipToTool}
</a>
<header>
  <div class="mx-auto flex w-full max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4">
    <a href={link('/')} class="flex items-center gap-2.5 font-mono text-small font-semibold">
      <Mark />
      <span>{copy.chrome.builtBy}</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-small">
        <li><a href={link('/static-vs-dynamic')} class="link">{copy.chrome.whyStatic}</a></li>
        <li><a href={link('/privacy')} class="link">{copy.chrome.privacy}</a></li>
        <li><a href={localizePath(pageKey, other)} hreflang={other} lang={other} class="link">{copy.chrome.langSwitch}</a></li>
      </ul>
    </nav>
  </div>
</header>
